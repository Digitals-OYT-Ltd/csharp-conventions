<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="xunit.v3" />
		<!-- Pin over the 9.0.6 that Analyzer.Testing pulls in through NuGet.Packaging 7.0.3:
		     GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 fail restore (NU1902/NU1903). Drop the pin
		     once Analyzer.Testing depends on a patched NuGet.Packaging. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Digitals.Testing.CSharp\Digitals.Testing.CSharp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The page each DT rule's help link opens. -->
		<EmbeddedResource Include="..\..\docs\rules\testing.md" LogicalName="rules.md" Link="docs\testing.md" />
	</ItemGroup>

</Project>
