<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Org code coverage policy, shipped with Digitals.Testing and handed to the Microsoft code
    coverage engine as its settings file. This controls the DENOMINATOR: what counts as coverable.

    No double hyphen anywhere in a comment in this file. XML forbids it inside a comment, the
    coverage engine rejects the whole document, and the run then reports "Zero tests ran" with
    nothing said about settings, coverage or XML. That is why the option names are spelled out in
    words here rather than written as flags.

    This is the Microsoft.Testing.Extensions.CodeCoverage schema, not coverlet's. A repo migrating
    from coverlet.runsettings cannot copy its Format, SkipAutoProps and Exclude elements across;
    the shapes differ and the resulting percentages move. Re-tune the exclusions once, then ratchet.

    Override for a whole repo by pointing DigitalsCoverageSettingsFile at a local file.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <!--
              The test assembly is not the subject under test, and neither is the coverage gate:
              it ships in lib/ so it lands in the consumer's output directory and is instrumented
              like any other assembly there. Left in, it adds its own uncovered lines to every
              consumer's denominator.
            -->
            <ModulePaths>
              <Exclude>
                <ModulePath>.*[Tt]ests\.dll$</ModulePath>
                <ModulePath>.*[Tt]ests\.exe$</ModulePath>
                <ModulePath>.*Digitals\.Testing\.Coverage\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <!-- Auto-property get/set bodies carry no logic, so counting them only inflates the
                 denominator and hides real gaps. -->
            <SkipAutoProps>True</SkipAutoProps>

            <!-- Honour the in-code marker. Excluded code leaves the denominator entirely, so the
                 percentage reflects only code where a missing test is a real gap. Mark genuinely
                 untestable code with [ExcludeFromCodeCoverage] AND a Justification. -->
            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
                <Attribute>^System\.ObsoleteAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <!-- EF Core migrations are generated, but only *.Designer.cs carries the
                 <auto-generated/> header, so the hand-written migration files are not skipped by
                 the attribute rules above. -->
            <Sources>
              <Exclude>
                <Source>.*\\[Mm]igrations\\.*</Source>
                <Source>.*/[Mm]igrations/.*</Source>
              </Exclude>
            </Sources>

            <!-- The test host itself is not under test. -->
            <CompanyNames>
              <Exclude>
                <CompanyName>.*Microsoft.*</CompanyName>
              </Exclude>
            </CompanyNames>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
