# ============================================================================
# Test severity policy, shipped with Digitals.Testing.
#
# Applied to every project that references this package, which is exactly the
# set of test projects — no `.Tests` name matching, no path globs. Digitals.Analyzers
# once shipped its own Tests globalconfig at level 200, which had to guess at test
# projects by project name because that package applies to production code too.
#
# global_level 300 beats Digitals.Analyzers' policy at 100. Precedence across two
# packages is decided by global_level alone.
#
# Keep it clear of every other level, because a TIE IS NOT A WIN. When two global
# configs set the same key at the same level, Roslyn drops the key outright and the
# value falls back to the next level down - even when both files set the identical
# value. At 200 every relaxation this file shared with the old Tests globalconfig
# silently reverted to the base severity. Verified on VSTHRD200.
#
# Precedence: a repo-local .editorconfig overrides anything in this file.
#
# DO NOT ADD A SECTION HEADER TO THIS FILE. Not [*], not a path glob, nothing.
# A global AnalyzerConfig only accepts absolute paths as section names; Roslyn
# rejects anything else with "warning InvalidGlobalSectionName" and silently
# drops that section AND every entry after it — here, the whole policy.
# ============================================================================
is_global = true
global_level = 300

# ----------------------------------------------------------------------------
# Custom test rules (DT#####), moved from Digitals.Analyzers.
# ----------------------------------------------------------------------------

# DT10001: xUnit test names are PascalCase segments separated by single underscores
dotnet_diagnostic.DT10001.severity = warning
# DT10003: every test carries a category trait, so no test runs in no CI job
dotnet_diagnostic.DT10003.severity = warning
# DT10004: no Thread.Sleep or bare Task.Delay in tests
dotnet_diagnostic.DT10004.severity = warning
# DT10005: every test reaches an assertion, followed through helpers in the same project
dotnet_diagnostic.DT10005.severity = warning

# ----------------------------------------------------------------------------
# Raised: vendor test rules that ship quieter than this policy wants.
# ----------------------------------------------------------------------------

# xUnit1004: skipped test. xunit.analyzers ships it as Info, so a Skip = "..." added to get
# a build green stays unnoticed long after anyone remembers why. A test that should only run
# on demand is [Fact(Explicit = true)] in xunit.v3, which this does not flag.
dotnet_diagnostic.xUnit1004.severity = warning

# ----------------------------------------------------------------------------
# Relaxations: rules that are right for production code and wrong for tests.
# ----------------------------------------------------------------------------

# CA1707: 'no underscores in identifiers' — DT10001 requires them in test method
# names, so leaving this on would make the two rules contradict each other.
# Digitals.Analyzers sets it to warning for production code.
dotnet_diagnostic.CA1707.severity = none
# CA1515: 'make public types internal' — fires on public test classes, which xUnit
# needs public, and a test project is an Exe so the rule is active. Digitals.Analyzers
# sets it to suggestion for production code.
dotnet_diagnostic.CA1515.severity = none
# DT00003: 'no new HttpClient()' — constructing one over a stub handler is how a
# DelegatingHandler gets tested, and the rule's reason (socket exhaustion and stale
# DNS in a long-lived process) does not apply to a test run. Digitals.Analyzers keeps
# it at warning for production code.
dotnet_diagnostic.DT00003.severity = none
# DT00013-DT00016, DT00018: 'one abstraction level per method' — a test repeats its
# act-and-assert steps (DT00013), builds its inputs in large initializers (DT00014) and
# field by field (DT00016), runs as long as its scenario needs (DT00015), and reads files
# and streams directly (DT00018), all on purpose. DT00017 stays on: tests check results
# with assertions, not an inline 'if failed, throw'.
dotnet_diagnostic.DT00013.severity = none
dotnet_diagnostic.DT00014.severity = none
dotnet_diagnostic.DT00015.severity = none
dotnet_diagnostic.DT00016.severity = none
dotnet_diagnostic.DT00018.severity = none
# CA1822: 'mark member static' — xUnit needs instance test methods
dotnet_diagnostic.CA1822.severity = none
# CA1852: 'seal internal type' — noise on fixtures / test doubles
dotnet_diagnostic.CA1852.severity = none
# CA2201: 'no reserved exception types' — tests throw Exception on purpose
dotnet_diagnostic.CA2201.severity = none
# CA1869: 'cache JsonSerializerOptions' — inline per-test fine
dotnet_diagnostic.CA1869.severity = none
# CA2012: 'consume ValueTask once' — relaxed in test arrange/assert
dotnet_diagnostic.CA2012.severity = none
# CA1001: 'disposable field -> IDisposable' — fixtures dispose in teardown
dotnet_diagnostic.CA1001.severity = none
# S2344: enum name suffix — test enums
dotnet_diagnostic.S2344.severity = none
# S4144: 'identical method bodies' — common in parameterized stubs
dotnet_diagnostic.S4144.severity = none
# S3881: 'full IDisposable pattern' — test doubles skip it
dotnet_diagnostic.S3881.severity = none
# S1172 / IDE0060: 'unused param' — [Theory] args / interface stubs keep them
dotnet_diagnostic.S1172.severity = none
dotnet_diagnostic.IDE0060.severity = none
# S1186: 'empty method' — no-op fakes / stubs
dotnet_diagnostic.S1186.severity = none
# S2701: 'bool literal in assertion' — Assert.True(true) fine
dotnet_diagnostic.S2701.severity = none
# VSTHRD200: 'Async' suffix — test methods read as scenarios, not async APIs
dotnet_diagnostic.VSTHRD200.severity = none
# VSTHRD002: sync-wait on task — no SynchronizationContext in xUnit
dotnet_diagnostic.VSTHRD002.severity = none
# VSTHRD003: await externally-started task — concurrency tests await shared TaskCompletionSource on purpose
dotnet_diagnostic.VSTHRD003.severity = none
# CA1859: 'concrete return type for perf' — irrelevant in test helpers/builders
dotnet_diagnostic.CA1859.severity = none
# CS1591: 'missing XML comment' - test classes and test methods are named, not documented
dotnet_diagnostic.CS1591.severity = none
# S2699: 'no assertion in this test' - blind to assertions made by a harness
# (CSharpAnalyzerTest.RunAsync, Verify, Testcontainers) or by an [Theory] data-driven helper.
# DT10005 replaces it: it follows helpers and takes a configurable list of harness methods.
dotnet_diagnostic.S2699.severity = none
# CS8600 / CS8604 / CS8625: nullable-flow — tests deliberately pass null to verify null-handling
dotnet_diagnostic.CS8600.severity = none
dotnet_diagnostic.CS8604.severity = none
dotnet_diagnostic.CS8625.severity = none
