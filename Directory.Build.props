<Project>

	<!--
		Solution-wide compiler and analyzer baseline, same as csharp-api-template, with two differences
		because this repo builds the analyzers instead of only consuming them:
		- No TargetFramework. The analyzers and the coverage gate are netstandard2.0 (they run inside
		  the compiler and the test host), Digitals.Testing and the tests are net10.0, so
		  each csproj keeps its own.
		- LangVersion is set. netstandard2.0 would otherwise mean C# 7.3; 14 is what net10.0 implies,
		  so every project here compiles as the same language.
	-->
	<PropertyGroup>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Pin the ruleset, not the SDK (csharp/pin-analyzer-ruleset) -->
		<AnalysisLevel>10.0</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>

		<!-- DIGB004 asks for it: the SDK only defaults to auditing transitive packages from net10.0, and
		     the analyzer and coverage gate projects here are netstandard2.0. -->
		<NuGetAuditMode>all</NuGetAuditMode>
	</PropertyGroup>

	<!--
		Digitals.Analyzers: the org-wide C# rules (DT0####), from the last release on nuget.org rather
		than from source. It updates with a version bump in Directory.Packages.props.
		Only the package project itself is left out, since a project cannot reference its own ID.
	-->
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Digitals.Analyzers'">
		<PackageReference Include="Digitals.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<!-- Each package ships from its own tag (analyzers/v*, testing/v*), set as MinVerTagPrefix in its csproj. -->
	<PropertyGroup>
		<Authors>Digitals OYT Ltd</Authors>
		<Company>Digitals OYT Ltd</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) Digitals OYT Ltd 2026</Copyright>
		<PackageProjectUrl>https://github.com/Digitals-OYT-Ltd/csharp-conventions</PackageProjectUrl>
		<PackageReleaseNotes>https://github.com/Digitals-OYT-Ltd/csharp-conventions/releases</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/Digitals-OYT-Ltd/csharp-conventions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
